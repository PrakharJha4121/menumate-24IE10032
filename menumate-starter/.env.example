# Copy to .env and fill in. Never put a real key in any file you submit.
# Reviewers run your code with their own values for these three variables, so read the settings only from here.
LLM_API_KEY=
# Groq's OpenAI-compatible endpoint; change if you use another provider.
LLM_BASE_URL=https://api.groq.com/openai/v1
# Pick a current model from your provider's model list and write the exact name in README.md.
LLM_MODEL=
